# ---------- API (apps/api) ----------
# Copie este arquivo para apps/api/.env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acessolivre?schema=public"
# Banco usado pelos testes (pnpm api test)
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/acessolivre_test?schema=public"
# Gere um segredo forte, por exemplo: openssl rand -hex 32
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio-longo"
JWT_EXPIRES_IN="7d"
PORT=3333
HOST=0.0.0.0
# Endereço público da API, usado para montar a URL das fotos
PUBLIC_URL="http://localhost:3333"
# Origens liberadas no CORS, separadas por vírgula ("*" libera todas, só para desenvolvimento)
CORS_ORIGIN="*"
UPLOAD_DIR="./uploads"

# ---------- App (apps/mobile) ----------
# Copie para apps/mobile/.env. Use o IP da sua máquina na rede local, não "localhost",
# para o celular com Expo Go conseguir acessar a API.
EXPO_PUBLIC_API_URL="http://192.168.0.10:3333"
