# IP da sua máquina na rede local (o celular com Expo Go precisa alcançar a API).
# No emulador Android, use http://10.0.2.2:3333
EXPO_PUBLIC_API_URL="http://192.168.0.10:3333"

# (Opcional) Tiles de um provedor que permite uso em apps (MapTiler, Stadia, Carto...).
# Sem isso, o app usa o mapa nativo (Google Maps no Android, Apple Maps no iOS).
# Não use tile.openstreetmap.org: a política de uso do OSM bloqueia apps (erro 403).
# EXPO_PUBLIC_MAP_TILES_URL="https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=SUA_CHAVE"
# EXPO_PUBLIC_MAP_TILES_ATTRIBUTION="© MapTiler © colaboradores do OpenStreetMap"
