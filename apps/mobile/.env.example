# Opcional. Sem esta variável, o app usa automaticamente o IP do PC que roda o Expo
# (o mesmo que o Expo Go usa), na porta 3333. Isso funciona no celular e no emulador.
#
# Só defina se a API estiver em outra máquina ou porta. Use o IP do PC na rede Wi-Fi
# (veja com "ipconfig" no Windows), nunca "localhost" ou "10.0.2.2" num celular de verdade.
# EXPO_PUBLIC_API_URL="http://192.168.0.10:3333"
